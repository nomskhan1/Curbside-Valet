// Prisma schema for Bring My Car
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Building {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  logoUrl   String?
  hasCarWash    Boolean @default(true)
  hasEvCharging Boolean @default(true)

  users        User[]
  vehicles     Vehicle[]
  adminBuildings AdminBuilding[]
}

// Junction table for Admin → multiple Buildings
model AdminBuilding {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  createdAt  DateTime @default(now())

  @@unique([adminId, buildingId])
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("GUEST")
  createdAt    DateTime @default(now())

  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id])

  unitNumber         String?
  mustChangePassword Boolean @default(false)

  // Sign-in protection: after 5 wrong passwords the account is locked
  // for 15 minutes.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  vehicles        Vehicle[]
  requests        Request[] @relation("RequestedBy")
  handledRequests Request[] @relation("HandledBy")
  washLogs        WashLog[]
  adminBuildings  AdminBuilding[]
  sharedVehicles  VehicleDriver[]

  @@index([buildingId])
}

model Vehicle {
  id           String   @id @default(cuid())
  make         String?
  model        String?
  color        String?
  licensePlate String?
  ticketNumber String
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id])
  createdAt    DateTime @default(now())
  isVisitor    Boolean  @default(false)
  fuelType     String   @default("GASOLINE")
  photoUrl     String?
  claimToken   String?  @unique
  buildingId   String?
  building     Building? @relation(fields: [buildingId], references: [id])
  section      String?
  location     String?
  washDay      String?

  requests  Request[]
  washLogs  WashLog[]
  drivers   VehicleDriver[]

  // Ticket numbers only need to be unique within a building, so two
  // garages can both use ticket #1042.
  @@unique([buildingId, ticketNumber])
  @@index([ownerId])
}

// Other people named on a car's monthly parking application. The first name
// on the application is the car's owner (Vehicle.ownerId); everyone listed
// here can also see the car and request it.
model VehicleDriver {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([vehicleId, userId])
  @@index([userId])
}

model WashLog {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])
  washDate      DateTime
  initials      String
  completedById String?
  completedBy   User?    @relation(fields: [completedById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([vehicleId, washDate])
}

model Request {
  id            String    @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id])
  requestedById String
  requestedBy   User      @relation("RequestedBy", fields: [requestedById], references: [id])
  handledById   String?
  handledBy     User?     @relation("HandledBy", fields: [handledById], references: [id])
  status        String    @default("WAITING")
  type          String    @default("PICKUP")
  etaMinutes    Int       @default(0)
  scheduledFor  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  // Speeds up the live queue, duplicate-request checks and history.
  @@index([status, completedAt])
  @@index([vehicleId, status])
  @@index([requestedById])
  @@index([createdAt])
}
